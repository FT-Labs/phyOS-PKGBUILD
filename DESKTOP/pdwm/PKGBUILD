# Maintainer: Arda Atci<phystecharda@gmail.com>
pkgname=pdwm
pkgver=1.4
_branch=pdwm
pkgrel=10
pkgdesc="pdwm window manager for phyOS"
arch=(x86_64)
url="https://github.com/r0-zero/pdwm/"
license=('MIT')
depends=('libxcb' 'libxft' 'imlib2' 'libconfig' 'phyOS-system-scripts' 'phyOS-sysconf')
makedepends=('git' 'make')
optdepends=('fonts-phyOS' 'dmenu-phyOS' 'st-phyOS' 'phyOS-picom')
provides=("pdwm")
options=('zipman')

prepare() {
  git clone $url --depth 1 -b $_branch
}

build() {
	cd "$pkgname"
	make
}

package() {
    cd "$pkgname"

    make PREFIX=/usr DESTDIR="$pkgdir/" install
    mkdir -p "${pkgdir}/etc/xdg"
    cp -rf pdwmc "${pkgdir}/etc/xdg/pdwm"
}
